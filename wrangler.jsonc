{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "van-graphics-website",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": true },
  // Keep variables added in the Cloudflare dashboard when deploying from GitHub
  "keep_vars": true
  // Live domain: add it in the Cloudflare dashboard (Custom Domain or Worker route) once chosen,
  // then update ORIGIN in build.py and LIVE_HOSTS below.
}
